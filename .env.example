# 複製這個檔案成 .env，再填入自己的值（.env 不會進 git）
# SITE 不用寫在這裡，由 yarn dev:chenyo / yarn dev:musong 自動帶入

# 辰銪
CHENYO_DATABASE_URL=postgres://chenyo_user:請換成密碼@localhost:5432/chenyo_ofc
CHENYO_PAYLOAD_SECRET=請換成一串隨機文字
CHENYO_SERVER_URL=http://chenyo.localhost:3000

# 沐嵩
MUSONG_DATABASE_URL=postgres://musong_user:請換成密碼@localhost:5432/musong_ofc
MUSONG_PAYLOAD_SECRET=請換成另一串隨機文字
MUSONG_SERVER_URL=http://musong.localhost:3001
